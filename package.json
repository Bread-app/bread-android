{
  "name": "bread-android",
  "main": "entrypoint.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "patch-package",
    "build:dev": "eas build -p android --profile development",
    "build:apk": "eas build -p android --profile preview",
    "build:play": "eas build -p android --profile production",
    "build:dapp-store": "eas build -p android --profile dapp-store",
    "build:dapp-store:local": "eas build -p android --profile dapp-store --local",
    "publish:dapp-store": "node scripts/publish-dapp-store.js",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "update:production": "eas update --channel production --platform android",
    "update:preview": "eas update --channel preview --platform android"
  },
