# Expo SDK 54 / React Native ecosystem peers are over-strict and conflict under
# npm's default resolver (e.g. crossmint's loose expo-modules-core>=2.0.0 peer
# pulls a too-new expo-modules-core that demands react-native-worklets ^0.8,
# conflicting with the SDK-locked 0.5.x). Let the direct deps drive resolution.
legacy-peer-deps=true
